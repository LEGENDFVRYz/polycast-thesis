# ----------------------------------------------------
# PolyCast — environment configuration
#
# (Copy this file to .env and adjust per host)
#
# To copy via terminal:
#   macOS/Linux: cp .env.example .env
#   Windows:     copy .env.example .env
# ----------------------------------------------------

# Environment selector: dev | prod
APP_ENV=dev

# Flask
SECRET_KEY=change-me-in-production
FLASK_PORT=5050

# Browser WebSocket broadcaster
BROWSER_WS_PORT=5051

# Canvas / MJPEG (prod defaults: 6 fps @ q65; dev defaults: 20 fps @ q85)
CANVAS_WIDTH=1980
CANVAS_HEIGHT=1980
MJPEG_WIDTH=600
MJPEG_HEIGHT=600
MJPEG_FPS=6
JPEG_QUALITY=65

# Stream cap
MAX_STREAM_CLIENTS=40

# Archiver
AUTOSAVE_INTERVAL_SEC=1.0
AUTOSAVE_ONLY_WHEN_DIRTY=true
MIN_FREE_DISK_MB=1024

# SQLite
SQLITE_BUSY_TIMEOUT_MS=5000

# Storage
ARCHIVE_DIR=archive
LOG_DIR=logs

# Pipeline stage selector (background/pipelines/).
# Runs a fusion/post-processing design without switching config manually.
# Unset uses config.py defaults. Shell variables override this value.
#
# fused          ESKF method : UWB corrects continuously during ink
# imu-shape      Experimental : UWB anchors pen-down; IMU draws the stroke
# imu-shape+pp   Adds a two-point pen-up anchor
# imu-shape+pp2  Adds velocity detrend + trace filter
# imu-only       Disables UWB correction for diagnostics
POLYCAST_MODE=imu-shape+pp2

# Serial (prototype reader)
SERIAL_PORT=COM3
BAUD_RATE=921600
