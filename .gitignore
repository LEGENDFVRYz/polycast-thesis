# Python cache
__pycache__/
*.py[cod]

# Test cache
.pytest_cache/

# Environments
.venv/
.conda/
.env

# Logs
*.log

# Databases
*.db

# CSS maps
*.css.map

# Generated Frames or Notes
docs/
archive/
instance/
app/static/gallery_images/

# Testing Directory
test/_datasets
test/batch/outputs
test/tuning/results

# Module self-test artifacts; the README documents the layout and stays tracked.
test/module_runs/*
!test/module_runs/README.md

# Generated logs
tuning_results/
logs/

# Sample Datas and Outputs
*.csv
*.npy
*.npz
*.png

# ...but the seeder's input manifest must ship with the repo.
!seed/seed_data.csv

# Editor / OS
# Share the project settings, ignore per-developer editor state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
